# Configuración MariaDB (Backend Store)
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=mlflow_db
MYSQL_USER=mlflow_user
MYSQL_PASSWORD=mlflow_password

# Configuración MinIO (Artifact Store S3)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret
MLFLOW_BUCKET_NAME=mlflow

# Configuración Redis (Cola de Jobs)
REDIS_PORT=6379

# Credenciales del bucket de modelos de T10 (AWS S3 REAL generado por Terraform,
# usuario IAM proyecto3-models, prefijo models/). OJO: estas NO son las de MinIO;
# MinIO usa MINIO_ROOT_USER/MINIO_ROOT_PASSWORD de arriba. Confundirlas hace que
# publish_model.py suba (o falle) contra el destino equivocado.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# T10 (opcional): probar la publicación/inferencia contra MinIO en vez de AWS.
#   MODELS_S3_USE_MINIO=1
# Para dar al bucket de modelos credenciales/región propias (independientes de las
# genéricas AWS_* de arriba):
#   MODELS_S3_BUCKET=
#   MODELS_AWS_ACCESS_KEY_ID=
#   MODELS_AWS_SECRET_ACCESS_KEY=
#   MODELS_AWS_REGION=us-east-1
# NO definas MODELS_S3_ENDPOINT_URL en despliegue AWS: si queda seteado (p. ej. al
# endpoint de MinIO), publish_model.py subiría a MinIO creyendo que va a AWS.