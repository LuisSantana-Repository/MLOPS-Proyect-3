# --- MariaDB (tabla de jobs vive en el mismo backend store de MLflow) ---
# En docker-compose el puerto externo es 3307 (ver README raíz).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=mlflow_user
MYSQL_PASSWORD=mlflow_password
MYSQL_DATABASE=mlflow_db
# Alternativa: una sola URL (tiene prioridad sobre las piezas de arriba)
# DATABASE_URL=mysql://mlflow_user:mlflow_password@127.0.0.1:3307/mlflow_db

# --- MLflow Tracking Server (REST API) ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT=proyecto3-clasificador

# --- Redis (cola de jobs que consume worker.py: lista 'ml_jobs') ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ML_JOBS_QUEUE=ml_jobs

# Raíz del repo con los artefactos de T03/T04/T07 (por defecto, la carpeta padre de portal/)
# REPO_ROOT=..

# --- T13: Models, Inference y cola de anotación ---
# Servicio de inferencia de T10 (docker compose up -d inference)
INFERENCE_URL=http://127.0.0.1:8000
# UI de MLflow para enlazar runs (por defecto, MLFLOW_TRACKING_URI)
# MLFLOW_UI_URL=http://127.0.0.1:5000

# Bucket de modelos publicados (mismas variables que serving/storage.py).
# AWS real: bucket y credenciales del usuario IAM de Terraform (T02). Nunca en Git.
S3_BUCKET=
MODELS_AWS_ACCESS_KEY_ID=
MODELS_AWS_SECRET_ACCESS_KEY=
MODELS_AWS_REGION=us-east-1
# Pruebas locales contra MinIO en vez de AWS (publish_model.py --use-minio):
# MODELS_S3_USE_MINIO=1
# MODELS_S3_BUCKET=mlflow

# MinIO del stack: imágenes subidas desde /inference (bucket creado al primer uso)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
ANNOTATION_BUCKET=annotation-images

# --- Portal de anotación (Proyectos 1 y 2) dentro de este portal (P0-2) ---
# Backend de anotación (docker compose up -d annotation-api). El portal le reenvía /api/p2/*.
P2_BACKEND_URL=http://127.0.0.1:3100
